# Sao chép thành `.env` rồi điền giá trị thật
# `.env` KHÔNG được commit (đã nằm trong .gitignore).
# Tệp này hiện chỉ phục vụ docker-compose.yml (MySQL). Biến cho backend/R2/JWT sẽ được thêm ở các gói sau.

# ── MySQL ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=doi_mat_khau_root
MYSQL_DATABASE=nebula
MYSQL_USER=nebula
MYSQL_PASSWORD=doi_mat_khau_nebula
# Cổng MySQL mở ra máy localhost. Đổi nếu 3306 đã bị chiếm.
MYSQL_HOST_PORT=3306
