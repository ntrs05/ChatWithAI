{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*",
  "//": "KHÔNG ghi mật khẩu vào file này. Mật khẩu và khóa bí mật nằm trong file .env ở thư mục gốc.",
  "Jwt": {
    "Issuer": "nebula",
    "Audience": "nebula-clients",
    "ExpireMinutes": 60
  },
  "Storage": {
    "MaxFileMb": 25,
    "QuotaMb": 1024
  },
  "Cors": { "Origins": [ "http://localhost:5173", "http://localhost:3000" ] }
}
