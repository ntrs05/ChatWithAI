# =====================================================================
#  Cấu hình bí mật của Nebula. File .env KHÔNG được commit lên Git.
#  Người mới vào server: copy .env.example thành .env rồi điền giá trị.
#  docker compose tự đọc file này; "dotnet run" cũng tự đọc (DotEnv.Load).
#  Không đặt dấu # ở cuối dòng có giá trị (sẽ bị tính là một phần giá trị).
# =====================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nebula
MYSQL_USER=nebula
MYSQL_PASSWORD=
# Cổng MySQL (trong Docker) mở ra máy thật. 3306 thường đã bị MySQL cài sẵn trên máy chiếm nên dùng 3307.
MYSQL_HOST_PORT=3307

# ---------- API ----------
API_HOST_PORT=5000
# Khóa ký JWT, dài tối thiểu 32 ký tự. Tạo mới: openssl rand -base64 48  (chạy trong Git Bash)
JWT_KEY=

# ---------- Đăng nhập Google ----------
# Lấy ở Google Cloud Console > APIs & Services > Credentials > OAuth client ID (loại Web application)
GOOGLE_CLIENT_ID=

# ---------- Admin hệ thống (nhiều email cách nhau bằng dấu phẩy) ----------
# Email trong ADMIN_EMAILS tự thành admin hệ thống khi đăng nhập.
ADMIN_EMAILS=

# ---------- AI tóm tắt (Google Gemini) ----------
# Lấy khóa miễn phí tại https://aistudio.google.com/apikey . Để trống thì nút Tóm tắt báo "chưa cấu hình".
GEMINI_API_KEY=
# Để trống = gemini-3.5-flash-lite. Xem danh sách model và hạn mức miễn phí trong Google AI Studio.
GEMINI_MODEL=

# ---------- Cuộc gọi nhóm (LiveKit SFU) — TÙY CHỌN ----------
# Để trống = dùng mesh WebRTC (≤ 6 người/phòng). Muốn phòng đông hơn: điền 3 dòng dưới rồi chạy: docker compose --profile sfu up -d
# LIVEKIT_URL là địa chỉ TRÌNH DUYỆT nối tới, VD ws://localhost:7880 (chạy thật phải là wss:// qua HTTPS).
LIVEKIT_URL=
LIVEKIT_API_KEY=
# Tối thiểu 32 ký tự. Tạo: openssl rand -base64 32
LIVEKIT_API_SECRET=
# Đặt true khi chạy trên VPS có IP công khai
LIVEKIT_USE_EXTERNAL_IP=false
