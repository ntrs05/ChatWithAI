{
  "name": "nebula-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend cho Hệ thống Chat & Voice (Layered + Modular Monolith + Pub-Sub)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
