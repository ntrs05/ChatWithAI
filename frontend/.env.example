# Địa chỉ backend Nebula cho proxy của `npm run dev` (mặc định http://localhost:5000)
# VITE_BACKEND_URL=http://localhost:5000

# Chỉ cần khi build/deploy mà frontend và backend KHÁC domain (cần cấu hình CORS ở backend):
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_HUB_URL=https://api.example.com/hubs/chat

# OAuth Client ID (Web application) trên Google Cloud — dùng cho nút "Tiếp tục với Google".
# Phải TRÙNG với GOOGLE_CLIENT_ID trong .env của backend, và thêm http://localhost:5173 vào "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=940336618664-r47bh14219mcl0jm9tiht1takb6gtgdg.apps.googleusercontent.com
